<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="..\Build.props" />

	<PropertyGroup>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<Nullable>disable</Nullable>
		<RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
	</PropertyGroup>

  <PropertyGroup>
    <ModDir>BepInEx\plugins\Fika</ModDir>
    <InstallOnHeadless>True</InstallOnHeadless>
    <!-- build.ps1 uses the installed SPT assemblies; retain checked-in references for upstream CI. -->
    <ManagedPath Condition="'$(SPTPath)' != ''">$(SPTPath)\EscapeFromTarkov_Data\Managed</ManagedPath>
    <ManagedPath Condition="'$(SPTPath)' == ''">$(MSBuildProjectDirectory)\..\References</ManagedPath>
    <!-- Fika requires the publicized/renamed EFT API supplied by upstream. -->
    <GameAssemblyPath>$(MSBuildProjectDirectory)\..\References\hollowed.dll</GameAssemblyPath>
    <SPTPluginsPath Condition="'$(SPTPath)' != ''">$(SPTPath)\BepInEx\plugins\spt</SPTPluginsPath>
    <SPTPluginsPath Condition="'$(SPTPath)' == ''">$(ManagedPath)</SPTPluginsPath>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <Reference>
      <Private>false</Private>
    </Reference>
  </ItemDefinitionGroup>

  <ItemGroup Condition="'$(SPTPath)' != ''">
    <Reference Include="$(ManagedPath)\UnityEngine.*.dll" />
  </ItemGroup>

	<!-- targets -->
	<PropertyGroup>
		<Configurations>Debug;Release;GoldMaster</Configurations>
		<DefineConstants Condition="'$(Configuration)' == 'GoldMaster|AnyCPU' ">TRACE;GOLDMASTER</DefineConstants>   
		</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='GoldMaster'">
		<DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
		<Optimize>true</Optimize>
		<PlatformTarget>AnyCPU</PlatformTarget>
	</PropertyGroup>
	
	<ItemGroup>
		<EmbeddedResource Include="Bundles\Files\masterbundle.bundle" />	
		<None Remove="Bundles\Files\masterbundle.bundle" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="BepInEx.Core" Version="5.*" />
		<PackageReference Condition="'$(SPTPath)' == ''" Include="UnityEngine.Modules" Version="2022.3.43" IncludeAssets="compile" />
	</ItemGroup>

	<ItemGroup>
		<!-- These are used by .github/workflows/dotnet-build.yml and when building from non-Windows OS -->
		<PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<Reference Include="AnimationSystem.Types" HintPath="$(ManagedPath)\AnimationSystem.Types.dll" Private="false" />
		<Reference Include="Assembly-CSharp" HintPath="$(GameAssemblyPath)" Private="false" />
		<Reference Include="bsg.componentace.compression.libs.zlib" HintPath="$(ManagedPath)\bsg.componentace.compression.libs.zlib.dll" Private="false" />
		<Reference Include="bsg.console.core" HintPath="$(ManagedPath)\bsg.console.core.dll" Private="false" />
		<Reference Condition="'$(SPTPath)' == ''" Include="com.unity.multiplayer-hlapi.Runtime" HintPath="$(ManagedPath)\com.unity.multiplayer-hlapi.Runtime.dll" />
		<Reference Include="Comfort" HintPath="$(ManagedPath)\Comfort.dll" Private="false" />
		<Reference Include="Comfort.Unity" HintPath="$(ManagedPath)\Comfort.Unity.dll" Private="false" />
		<Reference Include="CommonExtensions" HintPath="$(ManagedPath)\CommonExtensions.dll" Private="false" />
		<Reference Include="DissonanceVoip" HintPath="$(ManagedPath)\DissonanceVoip.dll" Private="false" />
		<Reference Include="DOTween" HintPath="$(ManagedPath)\DOTween.dll" />
		<Reference Include="DOTween.Modules" HintPath="$(ManagedPath)\DOTween.Modules.dll" />
		<Reference Include="ItemComponent.Types" HintPath="$(ManagedPath)\ItemComponent.Types.dll" Private="false" />
		<Reference Include="ItemTemplate.Types" HintPath="$(ManagedPath)\ItemTemplate.Types.dll" Private="false" />
		<Reference Include="Newtonsoft.Json" HintPath="$(ManagedPath)\Newtonsoft.Json.dll" Private="false" />
		<Reference Include="Sirenix.Serialization" HintPath="$(ManagedPath)\Sirenix.Serialization.dll" Private="false" />
		<Reference Include="spt-common" HintPath="$(SPTPluginsPath)\spt-common.dll" Private="false" />
		<Reference Include="spt-core" HintPath="$(SPTPluginsPath)\spt-core.dll" Private="false" />
		<Reference Include="spt-custom" HintPath="$(SPTPluginsPath)\spt-custom.dll" Private="false" />
		<Reference Include="spt-debugging" HintPath="$(SPTPluginsPath)\spt-debugging.dll" Private="false" />
		<Reference Include="spt-reflection" HintPath="$(SPTPluginsPath)\spt-reflection.dll" Private="false" />
		<Reference Include="spt-singleplayer" HintPath="$(SPTPluginsPath)\spt-singleplayer.dll" Private="false" />
		<Reference Include="System.Runtime.CompilerServices.Unsafe" HintPath="$(ManagedPath)\System.Runtime.CompilerServices.Unsafe.dll" />
		<Reference Include="Unity.Postprocessing.Runtime" HintPath="$(ManagedPath)\Unity.Postprocessing.Runtime.dll" Private="false" />
		<Reference Include="Unity.TextMeshPro" HintPath="$(ManagedPath)\Unity.TextMeshPro.dll" Private="false" />
		<Reference Include="UnityEngine" HintPath="$(ManagedPath)\UnityEngine.dll" Private="false" />
		<Reference Include="UnityEngine.UI" HintPath="$(ManagedPath)\UnityEngine.UI.dll" Private="false" />
		<Reference Include="websocket-sharp" HintPath="$(ManagedPath)\websocket-sharp.dll" Private="false" />
		</ItemGroup>

</Project>
